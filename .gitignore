# --- credentials / secrets (belt-and-suspenders; real secrets live in ~/ ) ---
# Never commit credential files even if one is ever copied/symlinked into the tree.
.employer-api-key
*employer-api-key*
*.env
.env
secrets/
*secret*
*credential*
*.key
*.pem
id_rsa*

# --- agentmemory runtime state — never commit (public repo); belongs in its
#     own data dir, not here. Landed in the repo root from a stray cwd. ---
data/

# --- machine-specific zsh login bootstrap (brew/MacPorts/OrbStack PATH) ---
# Relocated out of $HOME/.zprofile into $ZDOTDIR when ZDOTDIR was adopted. Holds
# per-machine paths (Apple Silicon brew prefix, etc.), so keep it untracked.
backups/.config/zsh/.zprofile

# --- macOS / editor noise ---
.DS_Store
__pycache__/
