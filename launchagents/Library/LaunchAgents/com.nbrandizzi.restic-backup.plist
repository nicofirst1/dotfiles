<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nbrandizzi.restic-backup</string>

    <!-- Daily encrypted+deduplicated backup of the heavy agent data (Claude Code
         + Hermes sessions/transcripts/state) to the rclone gdrive: remote via
         restic. Memories go to git separately; this is the ~1.4 GB that can't. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/nbrandizzi/dotfiles/scripts/backup-restic.sh</string>
    </array>

    <!-- 04:00 daily. NOT RunAtLoad: a multi-hundred-MB upload should not fire on
         every login. If the Mac is asleep at 04:00, launchd runs it on wake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/nbrandizzi/Library/Logs/restic/restic.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/nbrandizzi/Library/Logs/restic/restic.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- restic, rclone, and sqlite3 must resolve under launchd's bare PATH. -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/nbrandizzi</string>
    </dict>

    <!-- Low priority: this is background archival, not interactive work. -->
    <key>ProcessType</key>
    <string>Background</string>
    <key>Nice</key>
    <integer>10</integer>
</dict>
</plist>
