<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nbrandizzi.agentmemory-power-guard</string>

    <!-- Polls the power source and pauses agentmemory's GPU-heavy background
         loops while on battery (resumes them on AC). The script flips override
         flags in ~/.agentmemory/.env, which the engine reads live — no restart. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/nbrandizzi/dotfiles/scripts/agentmemory-power-guard.sh</string>
    </array>

    <!-- macOS has no native power-source WatchPath, so poll. 30s means the GPU
         drops within half a minute of unplugging — cheap (a few greps). -->
    <key>StartInterval</key>
    <integer>30</integer>

    <!-- Evaluate once at login too, so the correct state is set immediately. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/nbrandizzi/Library/Logs/agentmemory/power-guard.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/nbrandizzi/Library/Logs/agentmemory/power-guard.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/nbrandizzi</string>
    </dict>
</dict>
</plist>
